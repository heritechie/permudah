{
  "name": "permudah",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:vinext": "pnpm --filter web dev:vinext",
    "build:vinext": "pnpm --filter web build:vinext",
    "start:vinext": "pnpm --filter web start:vinext",
    "deploy:vinext": "pnpm --filter web deploy:vinext",
    "check:vinext": "pnpm --filter web exec vinext check"
  }
}