# Web3Forms access key for the Early Access form
# Copy to .env.local and fill in your key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Supabase project URL and publishable key (used by browser and server clients).
# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth (server-only) for the "Connect Google" flow (POC).
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# register the redirect URI below as an authorized redirect URI.
# Set GOOGLE_OAUTH_REDIRECT_URI to the absolute callback URL, e.g.
# https://your-domain.com/api/google/callback. In production this variable is
# required and must be https, so a spoofed Host header cannot change the OAuth
# redirect. If unset outside production, the callback URL is derived from the
# request origin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Secret used to HMAC-sign the short-lived, user-bound Google flow cookies
# (OAuth transaction and result reference). Generate with:
#   openssl rand -base64 32
# It is never sent to Google. Must be at least 32 characters; the flow fails
# closed when it is missing or short. For the Cloudflare Workers deployment set
# it with: pnpm --filter web exec wrangler secret put GOOGLE_OAUTH_COOKIE_SECRET
GOOGLE_OAUTH_COOKIE_SECRET=
